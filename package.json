{
  "name": "code3",
  "version": "0.1.0",
  "type": "module",
  "description": "不对劲 - 单局现场揭状·多解改写（微信/抖音/TapTap小游戏）",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bundle": "vite build",
    "build:wechat": "CODE3_PLATFORM=wechat vite build",
    "build:douyin": "CODE3_PLATFORM=douyin vite build",
    "build": "npm run typecheck && npm run test && vite build",
    "dev": "vite build --watch",
    "web": "vite --config vite.web.config.ts"
  },
  "dependencies": {
    "@pixi/unsafe-eval": "^7.3.2",
    "pixi.js": "^7.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  }
}
